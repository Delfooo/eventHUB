<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'EventHub' %></title>
    
    <link rel="stylesheet" href="/css/main.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="stylesheet" href="/css/main.css">
    
    <link rel="stylesheet" href="/css/notifications.css"> 
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <% if (typeof additionalCSS !== 'undefined') { %>
        <% additionalCSS.forEach(css => { %>
            <link rel="stylesheet" href="<%= css %>">
        <% }); %>
    <% } %>
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a href="/" class="logo">
                <i class="fas fa-calendar-alt"></i>
                EventHub
            </a>
            
            <div class="nav-links" id="navLinks">
                <a href="/" class="nav-link <%= page === 'home' ? 'active' : '' %>">
                    <i class="fas fa-home"></i> Home
                </a>
                
                <div id="authLinks" style="display: none; align-items: center; gap: 10px;">
                    <a href="/dashboard" class="nav-link <%= page === 'dashboard' ? 'active' : '' %>">
                        <i class="fas fa-th-large"></i> Dashboard
                    </a>
                    <a href="/my-events" class="nav-link <%= page === 'my-events' ? 'active' : '' %>">
                        <i class="fas fa-calendar-check"></i> I Miei Eventi
                    </a>
                    <a href="/profile" class="nav-link <%= page === 'profile' ? 'active' : '' %>">
                        <i class="fas fa-user"></i> Profilo
                    </a>
                    
                    <a href="/admin" class="nav-link admin-only" id="adminLink" style="display: none;">
                        <i class="fas fa-shield-alt"></i> Admin
                    </a>
                    
                    <div class="notification-bell-container">
                        <button class="notification-bell" id="notificationBell">
                            <i class="fas fa-bell"></i>
                            <span class="notification-badge" id="notificationBadge">0</span>
                        </button>

                        <div class="notification-dropdown" id="notificationDropdown">
                            <div class="notification-dropdown-header">
                                <h3>Notifiche</h3>
                                <button class="mark-all-read-btn" onclick="markAllNotificationsAsRead()">
                                    Segna tutte lette
                                </button>
                            </div>
                            <div class="notification-dropdown-body" id="notificationList">
                                <p class="text-center mt-2" id="noNotificationsMessage" style="display: none;">Nessuna nuova notifica.</p>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-danger btn-sm" id="logoutBtn" onclick="logout()">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </button>
                </div>
                
                <div id="guestLinks" style="display: flex; align-items: center; gap: 10px;">
                    <a href="/login" class="nav-link <%= page === 'login' ? 'active' : '' %>">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </a>
                    <a href="/register" class="btn btn-primary">
                        <i class="fas fa-user-plus"></i> Registrati
                    </a>
                </div>
            </div>
            
            <button class="hamburger" id="hamburger">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </nav>

    <main class="main-content">
        <div id="alertContainer"></div>
        
        <%- body %>
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 EventHub. Tutti i diritti riservati.</p>
            <div class="footer-links">
                <a href="#">Privacy Policy</a>
                <a href="#">Termini di Servizio</a>
                <a href="#">Contatti</a>
            </div>
        </div>
    </footer>

    <script src="/js/auth.js"></script>
    <script src="/js/utils.js"></script>
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script> 
    <script src="/js/notifications.js"></script>
    
    <% if (typeof additionalJS !== 'undefined') { %>
        <% additionalJS.forEach(js => { %>
            <script src="<%= js %>"></script>
        <% }); %>
    <% } %>
    
    <script>
        // Controlla lo stato di autenticazione all'avvio
        checkAuthStatus();
    </script>
</body>
</html>