<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a href="/" class="logo">
                <i class="fas fa-calendar-alt"></i>
                EventHub
            </a>
            
            <div class="nav-links" id="navLinks">
                <a href="/" class="nav-link">
                    <i class="fas fa-home"></i> Home
                </a>
                <a href="/dashboard" class="nav-link">
                    <i class="fas fa-th-large"></i> Dashboard
                </a>
                <a href="/admin" class="nav-link active">
                    <i class="fas fa-shield-alt"></i> Admin
                </a>
                
                <button class="btn btn-danger btn-sm" onclick="logout()">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </div>
            
            <button class="hamburger" id="hamburger">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </nav>

    <main class="admin-main">
        <aside class="admin-sidebar">
            <div class="admin-header">
                <div class="admin-badge">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3>Pannello Admin</h3>
                <p id="adminName">Caricamento...</p>
            </div>

            <nav class="admin-nav">
                <a href="#overview" class="admin-nav-link active" data-section="overview">
                    <i class="fas fa-chart-line"></i>
                    <span>Panoramica</span>
                </a>
                <a href="#users" class="admin-nav-link" data-section="users">
                    <i class="fas fa-users"></i>
                    <span>Gestione Utenti</span>
                </a>
                <a href="#events" class="admin-nav-link" data-section="events">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Gestione Eventi</span>
                </a>
                <a href="#reports" class="admin-nav-link" data-section="reports">
                    <i class="fas fa-flag"></i>
                    <span>Segnalazioni</span>
                    <span class="badge" id="reportsBadge">0</span>
                </a>
                <a href="#analytics" class="admin-nav-link" data-section="analytics">
                    <i class="fas fa-chart-bar"></i>
                    <span>Analytics</span>
                </a>
            </nav>

            <div class="admin-footer">
                <a href="/dashboard" class="btn btn-secondary btn-block">
                    <i class="fas fa-arrow-left"></i> Dashboard Utente
                </a>
            </div>
        </aside>

        <div class="admin-content">
            <div id="alertContainer"></div>

            <section id="overview-section" class="admin-section active">
                <div class="admin-section-header">
                    <div>
                        <h1>
                            <i class="fas fa-chart-line"></i>
                            Panoramica Sistema
                        </h1>
                        <p class="section-subtitle">Statistiche generali della piattaforma</p>
                    </div>
                    <button class="btn btn-primary" onclick="refreshStats()">
                        <i class="fas fa-sync-alt"></i> Aggiorna
                    </button>
                </div>

                <div class="admin-stats-grid">
                    <div class="admin-stat-card">
                        <div class="stat-header">
                            <div class="stat-icon blue">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-trend up">
                                <i class="fas fa-arrow-up"></i>
                                <span>+12%</span>
                            </div>
                        </div>
                        <div class="stat-body">
                            <h3 id="totalUsers">0</h3>
                            <p>Utenti Totali</p>
                            <div class="stat-progress">
                                <div class="progress-bar blue" style="width: 75%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div class="stat-header">
                            <div class="stat-icon green">
                                <i class="fas fa-user-check"></i>
                            </div>
                            <div class="stat-trend up">
                                <i class="fas fa-arrow-up"></i>
                                <span>+8%</span>
                            </div>
                        </div>
                        <div class="stat-body">
                            <h3 id="activeUsers">0</h3>
                            <p>Utenti Attivi</p>
                            <div class="stat-progress">
                                <div class="progress-bar green" style="width: 85%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div class="stat-header">
                            <div class="stat-icon red">
                                <i class="fas fa-user-slash"></i>
                            </div>
                            <div class="stat-trend down">
                                <i class="fas fa-arrow-down"></i>
                                <span>-3%</span>
                            </div>
                        </div>
                        <div class="stat-body">
                            <h3 id="blockedUsers">0</h3>
                            <p>Utenti Bloccati</p>
                            <div class="stat-progress">
                                <div class="progress-bar red" style="width: 15%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div class="stat-header">
                            <div class="stat-icon purple">
                                <i class="fas fa-user-shield"></i>
                            </div>
                            <div class="stat-trend neutral">
                                <i class="fas fa-minus"></i>
                                <span>0%</span>
                            </div>
                        </div>
                        <div class="stat-body">
                            <h3 id="adminUsers">0</h3>
                            <p>Amministratori</p>
                            <div class="stat-progress">
                                <div class="progress-bar purple" style="width: 10%"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="additional-stats">
                    <div class="stat-box">
                        <i class="fas fa-calendar-plus"></i>
                        <div>
                            <h4 id="totalEvents">0</h4>
                            <p>Eventi Totali</p>
                        </div>
                    </div>
                    <div class="stat-box">
                        <i class="fas fa-user-plus"></i>
                        <div>
                            <h4 id="recentUsers">0</h4>
                            <p>Nuovi Utenti (30gg)</p>
                        </div>
                    </div>
                    <div class="stat-box">
                        <i class="fas fa-percentage"></i>
                        <div>
                            <h4 id="activityRate">0%</h4>
                            <p>Tasso di Attività</p>
                        </div>
                    </div>
                    <div class="stat-box">
                        <i class="fas fa-users-cog"></i>
                        <div>
                            <h4 id="regularUsers">0</h4>
                            <p>Utenti Standard</p>
                        </div>
                    </div>
                </div>

                <div class="quick-actions-admin">
                    <h2>Azioni Rapide</h2>
                    <div class="actions-grid-admin">
                        <button class="action-btn" onclick="switchSection('users')">
                            <i class="fas fa-users"></i>
                            <span>Gestisci Utenti</span>
                        </button>
                        <button class="action-btn" onclick="switchSection('events')">
                            <i class="fas fa-calendar-check"></i>
                            <span>Modera Eventi</span>
                        </button>
                        <button class="action-btn" onclick="openEventModal()"> 
                            <i class="fas fa-calendar-plus"></i>
                            <span>Crea Nuovo Evento</span>
                        </button>
                        <button class="action-btn" onclick="exportData()">
                            <i class="fas fa-download"></i>
                            <span>Esporta Dati</span>
                        </button>
                        <button class="action-btn" onclick="switchSection('reports')">
                            <i class="fas fa-flag"></i>
                            <span>Segnalazioni</span>
                        </button>
                    </div>
                </div>
            </section>

            <section id="users-section" class="admin-section">
                <div class="admin-section-header">
                    <div>
                        <h1>
                            <i class="fas fa-users"></i>
                            Gestione Utenti
                        </h1>
                        <p class="section-subtitle">Visualizza e gestisci tutti gli utenti della piattaforma</p>
                    </div>
                    <div class="header-actions">
                        <input 
                            type="text" 
                            id="userSearchInput" 
                            placeholder="Cerca utente..."
                            class="search-input"
                            onkeyup="filterUsers()"
                        >
                        <button class="btn btn-primary" onclick="loadUsers()">
                            <i class="fas fa-sync-alt"></i> Ricarica
                        </button>
                    </div>
                </div>

                <div id="usersLoading" class="loading-state">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Caricamento utenti...</p>
                </div>

                <div id="usersTable" class="table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Ruolo</th>
                                <th>Stato</th>
                                <th>Registrato</th>
                                <th>Ultimo Login</th>
                                <th>Azioni</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody">
                            </tbody>
                    </table>
                </div>
            </section>

            <section id="events-section" class="admin-section">
                <div class="admin-section-header">
                    <div>
                        <h1>
                            <i class="fas fa-calendar-alt"></i>
                            Gestione Eventi
                        </h1>
                        <p class="section-subtitle">Visualizza e modera tutti gli eventi</p>
                    </div>
                    <button class="btn btn-primary" onclick="loadAllEvents()">
                        <i class="fas fa-sync-alt"></i> Ricarica
                    </button>
                </div>

                <div id="eventsLoading" class="loading-state">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Caricamento eventi...</p>
                </div>

                <div id="eventsList" class="admin-events-list">
                    </div>
            </section>

            <section id="reports-section" class="admin-section">
                <div class="admin-section-header">
                    <div>
                        <h1>
                            <i class="fas fa-flag"></i>
                            Segnalazioni
                        </h1>
                        <p class="section-subtitle">Gestisci le segnalazioni degli utenti</p>
                    </div>
                </div>

                <div class="reports-list">
                    <div class="empty-state">
                        <i class="fas fa-check-circle"></i>
                        <h3>Nessuna segnalazione</h3>
                        <p>Al momento non ci sono segnalazioni da gestire</p>
                    </div>
                </div>
            </section>

            <section id="analytics-section" class="admin-section">
                <div class="admin-section-header">
                    <div>
                        <h1>
                            <i class="fas fa-chart-bar"></i>
                            Analytics
                        </h1>
                        <p class="section-subtitle">Analisi dettagliate della piattaforma</p>
                    </div>
                </div>

                <div class="analytics-placeholder">
                    <i class="fas fa-chart-line"></i>
                    <h3>Analytics in Sviluppo</h3>
                    <p>Questa sezione conterrà grafici e analisi dettagliate</p>
                </div>
            </section>

        </div>
    </main>

    <div id="confirmModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalTitle">Conferma Azione</h3>
                <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
                <p id="modalMessage">Sei sicuro di voler procedere?</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal()">Annulla</button>
                <button class="btn btn-primary" id="modalConfirmBtn" onclick="confirmAction()">Conferma</button>
            </div>
        </div>
    </div>

    <div id="createEventModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Crea Nuovo Evento</h3>
                <button class="modal-close" onclick="closeEventModal()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="createEventForm">
                    <div class="form-group">
                        <label for="eventTitle">
                            <i class="fas fa-heading"></i> Titolo Evento
                        </label>
                        <input type="text" id="eventTitle" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="eventDescription">
                            <i class="fas fa-info-circle"></i> Descrizione
                        </label>
                        <textarea id="eventDescription" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="form-group">
                        <label for="eventImage">
                            <i class="fas fa-image"></i> Immagine Evento
                        </label>

                        <div class="image-upload-zone" id="imageDropZone">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <p>Trascina un'immagine qui o clicca per selezionare</p>
                            <small>JPEG, PNG, GIF, WEBP - Max 5MB</small>
                        </div>

                        <input 
                            type="file" 
                            id="eventImageFile" 
                            accept="image/*"
                            style="display: none;"
                        >

                        <img id="imagePreview" class="image-preview" style="display: none;">

                        <button type="button" class="btn btn-secondary mt-2" id="uploadImageBtn" disabled>
                            <i class="fas fa-upload"></i> Carica Immagine
                        </button>

                        <input type="hidden" id="eventImage">
                    </div>
                    
                    <div class="form-group">
                        <label for="eventDate">
                            <i class="fas fa-calendar"></i> Data Evento
                        </label>
                        <input type="date" id="eventDate" class="form-control" required>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block mt-3">
                        <i class="fas fa-plus-circle"></i> Crea Evento
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/utils.js"></script>
    <script src="/js/admin.js"></script>
    <script>
        // Funzioni Modal Crea Evento
        function openEventModal() {
            document.getElementById('createEventModal').style.display = 'block';
        }

        function closeEventModal() {
            document.getElementById('createEventModal').style.display = 'none';
        }
        
        // Verifica autenticazione e ruolo admin
        if (!requireAdmin()) {
            window.location.href = '/';
        } else {
            checkAuthStatus();
        }

        // Logica per Drop Zone e Anteprima Immagine (Minimal Logic)
        document.addEventListener('DOMContentLoaded', () => {
            const dropZone = document.getElementById('imageDropZone');
            const fileInput = document.getElementById('eventImageFile');
            const preview = document.getElementById('imagePreview');
            const uploadBtn = document.getElementById('uploadImageBtn');

            // 1. Clicca sulla Drop Zone
            dropZone.addEventListener('click', () => {
                fileInput.click();
            });

            // 2. Drag & Drop Events
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, preventDefaults, false);
            });

            function preventDefaults (e) {
                e.preventDefault();
                e.stopPropagation();
            }

            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, () => dropZone.classList.add('drag-over'), false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, () => dropZone.classList.remove('drag-over'), false);
            });

            dropZone.addEventListener('drop', handleDrop, false);

            function handleDrop(e) {
                const dt = e.dataTransfer;
                const files = dt.files;
                handleFiles(files);
            }

            // 3. Gestione selezione file
            fileInput.addEventListener('change', (e) => {
                handleFiles(e.target.files);
            });

            function handleFiles(files) {
                if (files.length > 0) {
                    const file = files[0];
                    if (file.size > 5 * 1024 * 1024) {
                        showAlert('L\'immagine è troppo grande. Max 5MB.', 'error');
                        fileInput.value = ''; // Resetta l'input file
                        preview.style.display = 'none';
                        preview.src = '';
                        uploadBtn.disabled = true;
                        return;
                    }
                    
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                        uploadBtn.disabled = false;
                        dropZone.style.display = 'none';
                    }
                    reader.readAsDataURL(file);
                }
            }
            
            // 4. Reset del form (se necessario, da implementare in una funzione di reset)
            function resetImageUpload() {
                fileInput.value = '';
                preview.src = '';
                preview.style.display = 'none';
                uploadBtn.disabled = true;
                dropZone.style.display = 'flex';
            }
            
            // Logica placeholder per il pulsante di upload (da connettere al tuo backend)
            uploadBtn.addEventListener('click', () => {
                showAlert('Funzione di Upload da connettere al Backend.', 'info');
                // Qui andrebbe la logica per inviare il file al server e ottenere l'URL,
                // che verrebbe poi inserito in: document.getElementById('eventImage').value = 'url_ottenuto';
            });
        });
    </script>
</body>
</html>